# ============================================================================
# day10 / .env
#
# 大模型配置。用于 utils/ai_debug_helper.py（失败自动排错）
# 与 utils/ai_assert.py（自然语言断言）。
#
# 三个配置项：
#     LLM_API_KEY   接口密钥。留空则 AI 相关能力自动降级为本地规则引擎，
#                   用例仍然能跑，只是排错结论由规则给出而非大模型
#     LLM_BASE_URL  OpenAI 兼容接口的基础地址，需要带 /v1 后缀
#     LLM_MODEL     模型名称
#
# 本文件已在 .gitignore 中列出，不要提交到版本库。
#
# 注意：这是参照基准副本，密钥已脱敏。
# 生成新框架时把本文件复制为 .env 并填入真实密钥，不要把密钥提交到版本库。
# ============================================================================

LLM_API_KEY=sk-xxxxxx请替换为你的真实密钥xxxxxx
LLM_BASE_URL=http://192.168.1.6:13000/v1
LLM_MODEL=MiniMax-M3.1-Flash
