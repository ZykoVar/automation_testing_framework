# ============================================================
# HAT 框架 AI 能力配置（OpenAI 兼容协议）
# 本文件已被 .gitignore 忽略，不会提交到仓库
# 不配也能跑全部用例 —— AI 断言和失败诊断会自动降级为本地规则
# ============================================================

# 大模型 API Key（必填，不填则 AI 能力走本地降级）
LLM_API_KEY=

# 大模型服务地址（OpenAI 兼容接口，通常以 /v1 结尾）
# 示例：https://api.openai.com/v1  或国产兼容服务地址
LLM_BASE_URL=

# 模型名（默认 gpt-4o-mini）
# 注意：用 ai_assert_screenshot 视觉断言时，需换成支持图片输入的模型
LLM_MODEL=gpt-4o-mini
